# ===== Configuración del backend de Dynamic Yield =====
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a git.

# ===== Base de datos (PostgreSQL) =====
# Local y Vercel usan Postgres. Para local puedes usar Neon, Vercel Postgres o
# un Postgres en Docker. DATABASE_URL = conexión normal (pooled en serverless);
# DIRECT_URL = conexión directa, usada por Prisma para migraciones (db push).
# En Vercel Postgres/Neon ambas te las da el panel; si tu proveedor no distingue,
# pon el mismo valor en las dos.
DATABASE_URL="postgresql://user:pass@host:5432/askanything?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/askanything?sslmode=require"

# Base del backend (no cambiar salvo necesidad)
DY_BASE_URL="https://adm.dynamicyield.com"

# --- AUTENTICACIÓN (opción A: paste manual desde tu navegador) ---
# Solo necesitas la COOKIE. El x-xsrf-token se deriva automáticamente de ella.
#
# Cómo obtenerla:
# 1. Abre la pestaña de DY logueado, F12 -> Network.
# 2. Lanza una pregunta y abre el request POST /agents/chats/...
# 3. En Request Headers copia el valor COMPLETO de "cookie" aquí:
DY_COOKIE=""

# (Opcional) Forzar un x-xsrf-token concreto. Si lo dejas vacío, se extrae
# automáticamente de la cookie XSRF-TOKEN dentro de DY_COOKIE.
DY_XSRF_TOKEN=""

# El id de sección de tu cuenta (header dy_section_id / sectionId del payload):
DY_SECTION_ID="8787656"

# ===== Microsoft 365 Copilot (Chat API vía Microsoft Graph) — OPCIONAL =====
# Permite preguntar a M365 Copilot en paralelo a DY (comparativa).
# Auth: device code flow (te logueas una vez en el navegador).
#
# Necesitas un App Registration en Entra ID (pídeselo a IT) con:
#   - "Allow public client flows" = Yes (para device code).
#   - Permisos DELEGADOS de Microsoft Graph (con consentimiento de admin):
#       Sites.Read.All, Mail.Read, People.Read.All,
#       OnlineMeetingTranscript.Read.All, Chat.Read,
#       ChannelMessage.Read.All, ExternalItem.Read.All
#   - Licencia Microsoft 365 Copilot en tu usuario.
#
# Si dejas estos valores vacíos, la integración de Copilot se desactiva sola.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""

# ===== GitHub Models (RAG / knowledge base — RFP assistant) — OPCIONAL =====
# API compatible con OpenAI para embeddings + chat, autenticada con un PAT.
# Da el motor del knowledge base (/kb): indexa tus RFPs/Q&A/PDFs y responde
# preguntas con citas, sin depender de consentimiento de admin.
#
# Cómo obtener el token:
# 1. github.com/settings/personal-access-tokens -> Fine-grained token.
# 2. Permiso: "Models" = Read-only (models:read).
# 3. Tu organización debe tener GitHub Models habilitado.
GITHUB_MODELS_TOKEN=""
# (Opcional) Cambiar modelos por defecto:
# GITHUB_MODELS_CHAT="openai/gpt-4.1-mini"
# GITHUB_MODELS_EMBED="openai/text-embedding-3-small"

# ===== Internal demo sharing (login estilo .htaccess) — OPCIONAL =====
# Si rellenas credenciales, TODA la app (páginas y API) pide login HTTP Basic
# (estilo .htaccess), sin exponer URL pública y sin Azure/Entra. Si lo dejas
# vacío, el login se desactiva (dev local). Nunca llegan al navegador.
#
# Opción A — varios usuarios (recomendado para un equipo), formato user:pass:
DEMO_AUTH_USERS=""
# Ejemplo: DEMO_AUTH_USERS="ana:Clave-larga-1,luis:Clave-larga-2"
#
# Opción B — un único usuario/contraseña compartidos:
DEMO_AUTH_USER=""
DEMO_AUTH_PASSWORD=""

# ===== Plantilla de respuesta del agente DY — OPCIONAL =====
# Por defecto el chat pide al agente respuestas con estructura fija
# (Summary / Details / References). Pon "false" para desactivarla.
DY_STRUCTURED_ANSWERS="true"
