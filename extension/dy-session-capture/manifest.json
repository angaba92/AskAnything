{
  "manifest_version": 3,
  "name": "AskAnything · Corporate bridge",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "description": "Connects AskAnything to VPN-only Dynamic Yield services and can refresh the legacy DY session.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://adm.dynamicyield.com/*",
    "https://*.dynamicyield.com/*",
    "https://dy-knowledge-assistant.use1.dev.dydy.io/*",
    "https://ask-anything-steel.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ask-anything-steel.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Capture DY session",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
